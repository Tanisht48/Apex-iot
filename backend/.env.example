# Everything is optional; the defaults below work out of the box.

# HTTP port (default 8080)
PORT=8080

# Origin allowed by CORS (default http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Secret used to sign JWTs. Set a long random value outside local development.
JWT_SECRET=change-me

# Fixed one-time code accepted by the demo login (default 1234)
DEMO_OTP=1234

# Set to "release" in production
GIN_MODE=debug
